# Generate secrets in the deployment platform, never in public source.
APP_ENV=production
PUBLIC_URL=https://your-backend-domain.example
MAIN_SITE_ORIGIN=https://kennystudio.cfd
DATA_DIR=/data
APP_SECRET=
ADMIN_EMAIL=hello@kennystudio.cfd
# Generate interactively: python -m app.setup
ADMIN_PASSWORD_HASH=
# Or set a private 12+ character password in Render (never in source):
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@kennystudio.cfd
SMTP_SSL=false
